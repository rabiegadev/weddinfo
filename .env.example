# Kanoniczny URL serwisu (linki w mailach)
# WEDDINFO_SITE_URL="https://weddinfo.pl"
# NEXT_PUBLIC_SITE_URL="https://weddinfo.pl"

# Sekret HMAC (min. 16 znaków) — captcha i sesja podglądu statusu
WEDDINFO_COOKIE_SECRET="zmien-na-dlugi-losowy-ciag-znakow"

# MySQL (SeoHost: srv91710_weddinfo)
# Na serwerze SeoHost: host localhost
# Na localu (npm run dev): host h63.seohost.pl + whitelist IP w panelu SeoHost
DATABASE_URL="mysql://user:password@h63.seohost.pl:3306/srv91710_weddinfo"

# Wysyłka e-maili SMTP — szczegóły: docs/konfiguracja-mail.md
SMTP_HOST="mail.twoja-domena.pl"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="powiadomienia@twoja-domena.pl"
SMTP_PASS=""
WEDDINFO_MAIL_FROM=""
WEDDINFO_CONTACT_NOTIFY_EMAIL=""

# Opcjonalnie: katalog uploadów z formularzy (domyślnie: storage/inquiries)
# WEDDINFO_UPLOAD_DIR=""

# Panel admina — hash bcrypt w Base64 (Next.js psuje surowy hash przez znaki $ w .env)
# Wygeneruj: npm run admin:hash-password -- "twoje-haslo"
# WEDDINFO_ADMIN_PASSWORD_HASH_B64=""

# Dev: pokaż hasło gościa na ekranie po wysłaniu (NIE w produkcji)
# WEDDINFO_DEV_RETURN_PASSWORD="true"

# Cloudflare Turnstile (opcjonalnie) — gdy ustawione OBA klucze, zastępuje captcha matematyczną.
# Klucze wygenerujesz w panelu Cloudflare → Turnstile.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""
